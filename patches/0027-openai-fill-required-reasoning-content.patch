+    @staticmethod
+    def _model_info_requires_reasoning_content(litellm_params: Mapping[str, object] | None) -> bool:
+        """True only when deployment model_info sets requires_reasoning_content."""
+        if litellm_params is None:
+            return False
+        candidates: Final[list[object]] = []
+        info = litellm_params.get("model_info") if isinstance(litellm_params, Mapping) else None
+        if info is not None:
+            candidates.append(info)
+        metadata = litellm_params.get("metadata") if isinstance(litellm_params, Mapping) else None
+        if isinstance(metadata, Mapping):
+            nested = metadata.get("model_info")
+            if nested is not None:
+                candidates.append(nested)
+        for candidate in candidates:
+            if isinstance(candidate, Mapping) and candidate.get("requires_reasoning_content") is True:
+                return True
+            extra = getattr(candidate, "model_extra", None) or getattr(candidate, "__pydantic_extra__", None)
+            if isinstance(extra, Mapping) and extra.get("requires_reasoning_content") is True:
+                return True
+            if getattr(candidate, "requires_reasoning_content", None) is True:
+                return True
+        return False
+
+    @staticmethod
+    def _promoted_reasoning_content(msg: Mapping[str, object]) -> str | None:
+        stored = msg.get("reasoning_content")
+        if isinstance(stored, str) and stored.strip():
+            return stored
+        reasoning = msg.get("reasoning")
+        if isinstance(reasoning, str) and reasoning.strip():
+            return reasoning
+        details = msg.get("reasoning_details")
+        if isinstance(details, list):
+            texts: Final = tuple(
+                text
+                for block in details
+                if isinstance(block, Mapping)
+                for text in (block.get("text"),)
+                if isinstance(text, str) and text.strip()
+            )
+            if texts:
+                return "\n".join(texts)
+        provider_fields = msg.get("provider_specific_fields")
+        if isinstance(provider_fields, Mapping):
+            nested = provider_fields.get("reasoning_content")
+            if isinstance(nested, str) and nested.strip():
+                return nested
+        return None
+
+    def _fill_required_reasoning_content(self, messages: list[AllMessageValues]) -> list[AllMessageValues]:
+        """DeepSeek thinking+tools requires reasoning_content on assistant tool-call turns.
+
+        Promote reasoning / reasoning_details / provider_specific_fields, else inject a
+        single space (the minimum the API accepts).
+        """
+        result: Final[list[AllMessageValues]] = []
+        for msg in messages:
+            if not isinstance(msg, Mapping):
+                result.append(msg)
+                continue
+            if msg.get("role") != "assistant" or not msg.get("tool_calls"):
+                result.append(msg)
+                continue
+            existing = msg.get("reasoning_content")
+            if isinstance(existing, str) and existing.strip():
+                result.append(msg)
+                continue
+            promoted = self._promoted_reasoning_content(msg)
+            patched = dict(cast(dict, msg))
+            patched["reasoning_content"] = promoted if promoted is not None else " "
+            result.append(cast(AllMessageValues, patched))
+        return result
+
