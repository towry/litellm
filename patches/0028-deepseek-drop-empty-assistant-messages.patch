+    @staticmethod
+    def _assistant_content_is_empty(content: object) -> bool:
+        if content is None or content == "":
+            return True
+        if not isinstance(content, list):
+            return False
+        if not content:
+            return True
+        return all(
+            isinstance(block, Mapping)
+            and block.get("type") in ("text", "output_text")
+            and not block.get("text")
+            for block in content
+        )
+
+    @staticmethod
+    def _is_empty_assistant_message(message: object) -> bool:
+        if not isinstance(message, Mapping):
+            return False
+        if message.get("role") != "assistant":
+            return False
+        if message.get("tool_calls") or message.get("function_call"):
+            return False
+        return DeepSeekChatConfig._assistant_content_is_empty(message.get("content"))
+
+    def _drop_empty_assistant_messages(self, messages: list[AllMessageValues]) -> list[AllMessageValues]:
+        return [message for message in messages if not self._is_empty_assistant_message(message)]
