+    @staticmethod
+    def _assistant_content_is_empty(content: object) -> bool:
+        if content is None or content == "":
+            return True
+        if not isinstance(content, list):
+            return False
+        if not content:
+            return True
+        return all(
+            isinstance(block, Mapping)
+            and block.get("type") in ("text", "output_text")
+            and not block.get("text")
+            for block in content
+        )
+
+    def _coerce_empty_assistant_content(self, messages: list[AllMessageValues]) -> list[AllMessageValues]:
+        return [
+            (
+                cast(
+                    AllMessageValues,
+                    {**cast(Mapping[str, object], message), "content": ""},
+                )  # cast-ok: TypedDict spread narrows to dict
+                if isinstance(message, Mapping)
+                and message.get("role") == "assistant"
+                and self._assistant_content_is_empty(message.get("content"))
+                else message
+            )
+            for message in messages
+        ]
+
