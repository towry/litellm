diff --git a/litellm/litellm_core_utils/streaming_handler.py b/litellm/litellm_core_utils/streaming_handler.py
--- a/litellm/litellm_core_utils/streaming_handler.py
+++ b/litellm/litellm_core_utils/streaming_handler.py
@@ -205,6 +205,28 @@ class CustomStreamWrapper:
 
         self._post_streaming_hooks: Optional[List] = None
 
+        self._tool_call_ids: Dict[tuple[int, int], str] = {}
+
+    def _normalize_tool_call_ids(self, response: ModelResponseStream) -> ModelResponseStream:
+        for choice in response.choices:
+            tool_calls = getattr(choice.delta, "tool_calls", None)
+            if tool_calls is None:
+                continue
+            for tool_call in tool_calls:
+                key = (choice.index, tool_call.index)
+                if key in self._tool_call_ids:
+                    tool_call.id = None
+                    continue
+                current_id = tool_call.id
+                canonical_id = (
+                    current_id
+                    if isinstance(current_id, str) and current_id.strip()
+                    else f"call_{uuid.uuid4().hex}"
+                )
+                self._tool_call_ids[key] = canonical_id
+                tool_call.id = canonical_id
+        return response
+
     def _check_max_streaming_duration(self) -> None:
         """Raise litellm.Timeout if the stream has exceeded LITELLM_MAX_STREAMING_DURATION_SECONDS."""
         from litellm.constants import LITELLM_MAX_STREAMING_DURATION_SECONDS
@@ -1484,4 +1507,6 @@ class CustomStreamWrapper:
                 model_response=model_response,  # type: ignore
                 response_obj=response_obj,
             )
+            if isinstance(result, ModelResponseStream):
+                return self._normalize_tool_call_ids(result)
             return result
