 class OpenAIChatCompletionStreamingHandler(BaseModelResponseIterator):
+    def __init__(self, streaming_response, sync_stream: bool, json_mode: Optional[bool] = False):
+        super().__init__(streaming_response, sync_stream, json_mode)
+        self._tool_call_ids: Dict[Tuple[int, int], str] = {}
+
+    def _ensure_tool_call_ids(self, response: ModelResponseStream) -> ModelResponseStream:
+        for choice in response.choices:
+            tool_calls = getattr(choice.delta, "tool_calls", None)
+            if tool_calls is None:
+                continue
+            for tool_call in tool_calls:
+                key = (choice.index, tool_call.index)
+                current_id = tool_call.id
+                stored_id = self._tool_call_ids.get(key)
+                if stored_id is None:
+                    stored_id = (
+                        current_id
+                        if isinstance(current_id, str) and current_id.strip()
+                        else f"call_{uuid.uuid4().hex}"
+                    )
+                    self._tool_call_ids[key] = stored_id
+                if current_id != stored_id:
+                    tool_call.id = stored_id
+        return response
+
