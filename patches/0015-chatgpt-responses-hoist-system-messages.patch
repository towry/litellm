             headers,
         )
+        input_items = request.get("input")
+        system_instruction_parts = (
+            tuple(
+                text
+                for item in input_items
+                if (text := self._system_message_text(item)) is not None and text
+            )
+            if isinstance(input_items, list)
+            else ()
+        )
+        if isinstance(input_items, list):
+            request["input"] = [item for item in input_items if self._system_message_text(item) is None]
