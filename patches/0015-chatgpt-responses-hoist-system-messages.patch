         return {**default_headers, **headers}
 
+    @staticmethod
+    def _system_message_text(item: object) -> Optional[str]:
+        if not isinstance(item, Mapping) or item.get("role") != "system":
+            return None
+
+        content = item.get("content")
+        if isinstance(content, str):
+            return content
+        if not isinstance(content, Sequence):
+            return None
+
+        text_parts = tuple(
+            block.get("text")
+            for block in content
+            if isinstance(block, Mapping)
+            and isinstance(block.get("text"), str)
+        )
+        if len(text_parts) != len(content):
+            return None
+        return "\n".join(text_parts)
+
     def transform_responses_api_request(
         self,
         model: str,
         input: Any,
@@ -72,13 +92,35 @@ class ChatGPTResponsesAPIConfig(OpenAIResponsesAPIConfig):
             response_api_optional_request_params,
