#!/usr/bin/env bash
set -euo pipefail

# Amp Orb setup for the towry/litellm deploy (patch-only) branch.
# Non-interactive and idempotent. Do not start long-lived processes here.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step_started=$SECONDS
finish_step() {
  echo "[orb-setup] $1 complete ($((SECONDS - step_started))s)"
  step_started=$SECONDS
}

echo "[orb-setup] Installing missing system packages"
system_packages=(
  build-essential
  ca-certificates
  curl
  git
  python3
  python3-dev
  python3-venv
)
missing_packages=()
for package in "${system_packages[@]}"; do
  dpkg-query -W -f='${db:Status-Abbrev}' "$package" 2>/dev/null | grep -Fqx 'ii ' ||
    missing_packages+=("$package")
done
if ((${#missing_packages[@]})); then
  sudo apt-get -o DPkg::Lock::Timeout=120 update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get \
    -o DPkg::Lock::Timeout=120 \
    install -y --no-install-recommends \
    "${missing_packages[@]}"
fi
finish_step "System packages"

echo "[orb-setup] Ensuring uv is installed to ~/.local/bin"
export PATH="$HOME/.local/bin:$PATH"
uv_bin="$HOME/.local/bin/uv"
if [ ! -x "$uv_bin" ]; then
  curl -LsSf https://astral.sh/uv/install.sh | sh
  export PATH="$HOME/.local/bin:$PATH"
  hash -r
fi
"$uv_bin" --version

uv_profile_marker="# litellm orb uv path"
if ! grep -Fqx "$uv_profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'PROFILE_EOF'

# litellm orb uv path
if [ -x "$HOME/.local/bin/uv" ]; then
  export PATH="$HOME/.local/bin:$PATH"
fi
PROFILE_EOF
fi
finish_step "uv"

echo "[orb-setup] Ensuring canonical LiteLLM source tree"
# Read-only sibling worktree of this fork's origin/main.
# Never clone BerriAI/litellm. Never commit or push in this tree.
source_dir="$(cd "$repo_root/.." && pwd)/litellm-main"
if [ -d "$source_dir/.git" ]; then
  echo "[orb-setup] Reusing existing $source_dir"
elif [ ! -e "$source_dir" ]; then
  git -C "$repo_root" fetch origin main --depth 1
  git -C "$repo_root" worktree add --detach "$source_dir" origin/main
else
  echo "[orb-setup] $source_dir exists but is not a git checkout; leaving it"
fi
finish_step "LiteLLM source tree"

echo "[orb-setup] Preparing Python toolchain in the source tree"
# Patch work only needs CPython + uv. Skip LiteLLM's full uv.lock sync
# (proxy extras / prisma) so setup stays inside the orb time budget.
if [ -d "$source_dir" ] && [ ! -d "$source_dir/.venv" ]; then
  (
    cd "$source_dir"
    "$HOME/.local/bin/uv" venv --python 3.11 .venv
  )
fi
finish_step "Python toolchain"

amp_config_dir="$HOME/.config/amp"
mkdir -p "$amp_config_dir"
orb_guidance_marker="# LiteLLM deploy orb guidance"
if ! grep -Fqx "$orb_guidance_marker" "$amp_config_dir/AGENTS.md" 2>/dev/null; then
  cat >> "$amp_config_dir/AGENTS.md" <<'EOF'

# LiteLLM deploy orb guidance

- Default checkout is the `deploy` patch-only branch. Do not edit LiteLLM source here.
- Canonical read-only source tree: `../litellm-main` (this repo's `origin/main` worktree).
- Never clone or use `BerriAI/litellm` / `../litellm-upstream` as the patch baseline.
- Put deploy-ready patches in `./patches` and update `./patches/series`.
- Do not commit or push in `../litellm-main`.
- Do not write or run unit tests; syntax-check with `python3 -m py_compile`.
- `uv` is installed to `~/.local/bin`. Source-tree `.venv` is empty of LiteLLM deps on purpose.
- Use tmux session `dev` for interactive background work.
EOF
fi
finish_step "Orb agent guidance"

echo "[orb-setup] Complete"
